# EaseScore.AI — copy to .env.local and fill in. Never commit real values.

# Supabase (browser-safe: publishable key only works with RLS on)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key — server only, never NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Server-only API keys
ANTHROPIC_API_KEY=
RENTCAST_API_KEY=
HUD_API_TOKEN=
CENSUS_API_KEY=
FRED_API_KEY=

# Contact email shown in the research collector User-Agent
RESEARCH_CONTACT=

# Google Map Tiles API (browser key; restrict to your domains + Map Tiles API only)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Supabase Management API token (scripts/sql.sh only; never shipped to the browser)
SUPABASE_ACCESS_TOKEN=

# Optional: Chrome/Chromium path for PDF rendering (defaults to the installed Chrome)
CHROME_PATH=

# Policy seat: let /api/policy/state queue uncomputed lever states for scripts/policy_batch.ts --queue.
# Set to 1 only where the batch job runs (local). Unset in production (no batch worker there).
POLICY_ALLOW_QUEUE=

# Scenario data loop: store anonymous pro forma scenarios (opt-in, no personal data). Set to 1 only after the
# notice text is approved. Unset = off (nothing collected; the "Don't use my numbers" toggle still shows).
SCENARIO_COLLECTION=
